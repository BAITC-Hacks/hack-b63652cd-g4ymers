# Domain names only: no https://, slash, or port.
AKIM_DOMAIN=akim.example.com
CITIZEN_DOMAIN=citizen.example.com
ACME_EMAIL=ops@example.com

# Replace both passwords before the first start; do not commit deploy/.env.
DATABASE_NAME=hackalem
DATABASE_PASSWORD=replace-with-48-random-hex-characters
AKIM_EMAIL=akim@example.com
AKIM_PASSWORD=replace-with-another-48-random-hex-characters
APP_VERSION=first-release

# Enable only for a separate hackathon demo; never imports by default.
DEMO_RESIDENTS=false
DEMO_RESIDENT_PASSWORD=
